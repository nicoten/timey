<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Marks timey as a menu bar accessory at launch. The Rust side also calls
    set_activation_policy(Accessory), but that runs after the app is already up:
    without this key the Dock icon appears for a moment and the app shows in the
    app switcher until the call lands.
  -->
  <key>LSUIElement</key>
  <true/>

  <!-- Shown in the macOS prompt the first time Timey scripts Mail. -->
  <key>NSAppleEventsUsageDescription</key>
  <string>Timey opens a mail draft with your invoice attached.</string>
</dict>
</plist>
