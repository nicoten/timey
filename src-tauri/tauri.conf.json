{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "timey",
  "version": "0.1.0",
  "identifier": "com.nicotejera.timey",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "timey",
        "width": 1180,
        "height": 800,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5N0EyMTFEQzMxMzUxQTIKUldTaVVSUERIU0Y2R1VYNmpxUG5yVjVhYXR1Y2tuampsaDBiMFRuNjJuVXh2ZjRJZEFGYlBvRm0K",
      "endpoints": [
        "https://github.com/nicoten/timey/releases/latest/download/latest.json"
      ]
    }
  }
}
