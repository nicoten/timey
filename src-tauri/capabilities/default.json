{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "updater:default",
    "process:default",
    "autostart:default",
    "core:window:allow-hide",
    "dialog:allow-open",
    "opener:allow-reveal-item-in-dir",
    "opener:allow-open-url"
  ]
}
