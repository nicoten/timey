<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Required to script Apple Mail. The build uses the hardened runtime, which
    blocks Apple Events to other apps unless this is granted; without it the
    draft silently fails and every send falls back to an unattached mailto.
  -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
